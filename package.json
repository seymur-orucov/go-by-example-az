{
  "name": "platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Learning platform workspace (technology and direction roadmaps, theory + practice). Working name; see docs/DECISIONS.md.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @platform/site dev",
    "build": "pnpm --filter @platform/site build",
    "preview": "pnpm --filter @platform/site preview",
    "check": "pnpm -r --if-present check",
    "content:check": "pnpm --filter @platform/site content:check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
