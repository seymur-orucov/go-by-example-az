---
import Layout from "@platform/theme/components/Layout.astro";
import { getGoCatalog, hasAdaptedLessons } from "../lib/go";
import { getSyllabusCatalog } from "../lib/syllabus";
import { getTechnologies } from "../lib/technologies";

interface Props {
  title: string;
  description?: string;
  /** Nav item shown as the current page: "roadmaps" or a technology id ("go", "git"). */
  current?: string;
  lesson?: boolean;
  bodyClass?: string;
}

const { sections } = await getGoCatalog();
const attribution = await hasAdaptedLessons();
const technologies = await getTechnologies();

// Ctrl+K: every Go topic, plus the topics of the other active technologies (section "Git · …");
// page scripts read the same JSON (progress, ready flags).
const searchIndex = [
  ...sections.flatMap((s) =>
    s.items.map((e) => ({
      slug: e.slug,
      title: e.title,
      sub: e.sub,
      section: s.title,
      n: e.n,
      href: e.href,
      ready: e.status === "ready",
    })),
  ),
  ...technologies
    .filter((t) => t.id !== "go" && t.href)
    .flatMap((t) =>
      getSyllabusCatalog(t.id).sections.flatMap((s) =>
        s.items.map((e) => ({
          slug: e.slug,
          title: e.title,
          sub: e.sub,
          section: `${t.name} · ${s.title}`,
          n: e.n,
          href: e.href,
          ready: e.status === "ready",
        })),
      ),
    ),
];
---

<Layout
  {...Astro.props}
  searchIndex={searchIndex}
  technologies={technologies}
  attribution={attribution}
>
  <slot name="before-header" slot="before-header" />
  <slot />
</Layout>
