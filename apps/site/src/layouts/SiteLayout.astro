---
import Layout from "@platform/theme/components/Layout.astro";
import { getGoCatalog, hasAdaptedLessons } from "../lib/go";
import { getSyllabusCatalog } from "../lib/syllabus";
import { getTechnologies } from "../lib/technologies";

interface Props {
  title: string;
  description?: string;
  /** Technology section the page belongs to ("go", "git"). */
  tech?: string;
  lesson?: boolean;
}

const { sections } = await getGoCatalog();
const attribution = await hasAdaptedLessons();
const technologies = await getTechnologies();

// Ctrl+K: every Go topic, plus the topics of other active technologies (section shows "Git · …").
const searchIndex = [
  ...sections.flatMap((s) =>
    s.items.map((e) => ({
      slug: e.slug,
      title: e.title,
      sub: e.sub,
      section: s.title,
      n: e.n,
      href: e.href,
    })),
  ),
  ...technologies
    .filter((t) => t.id !== "go" && t.href)
    .flatMap((t) =>
      getSyllabusCatalog(t.id).sections.flatMap((s) =>
        s.items.map((e) => ({
          slug: e.slug,
          title: e.title,
          sub: e.sub,
          section: `${t.name} · ${s.title}`,
          n: e.n,
          href: e.href,
        })),
      ),
    ),
];
---

<Layout
  {...Astro.props}
  searchIndex={searchIndex}
  technologies={technologies}
  attribution={attribution}
>
  <slot />
</Layout>
