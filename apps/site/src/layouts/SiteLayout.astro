---
import Layout from "@platform/theme/components/Layout.astro";
import { getGoCatalog, hasAdaptedLessons } from "../lib/go";

interface Props {
  title: string;
  description?: string;
  current?: "roadmaps" | "go";
  lesson?: boolean;
  bodyClass?: string;
}

const { sections } = await getGoCatalog();
const attribution = await hasAdaptedLessons();

// Go lessons for the Ctrl+K palette; page scripts read the same JSON (progress, ready flags).
const searchIndex = sections.flatMap((s) =>
  s.items.map((e) => ({
    slug: e.slug,
    title: e.title,
    sub: e.sub,
    section: s.title,
    n: e.n,
    href: e.href,
    ready: e.status === "ready",
  })),
);
---

<Layout {...Astro.props} searchIndex={searchIndex} attribution={attribution}>
  <slot name="before-header" slot="before-header" />
  <slot />
</Layout>
