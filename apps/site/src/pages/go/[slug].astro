---
// Lesson page /go/<slug>/ (design v2). Ready lessons get the full walkthrough; planned topics
// get a short "in preparation" page so links from /go/ and the sidebar never 404.
import LessonSidebar from "../../components/LessonSidebar.astro";
import Quiz from "../../components/Quiz.astro";
import Takeaways from "../../components/Takeaways.astro";
import Vis from "../../components/Vis.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getGoCatalog, LEVEL_LABEL, type GoItem } from "../../lib/go";
import { highlightLines, renderLines } from "../../lib/highlight";
import { loadLesson } from "../../lib/lesson";
import { renderInline, renderMarkdown } from "../../lib/markdown";
import "../../styles/lesson.css";

export async function getStaticPaths() {
  const { sections } = await getGoCatalog();
  const flat = sections.flatMap((s) => s.items.map((item) => ({ item, sectionId: s.id })));
  return flat.map(({ item, sectionId }, i) => ({
    params: { slug: item.slug },
    props: { item, sectionId, prev: flat[i - 1]?.item, next: flat[i + 1]?.item },
  }));
}

interface Props {
  item: GoItem;
  sectionId: string;
  prev?: GoItem;
  next?: GoItem;
}

const { item, sectionId, prev, next } = Astro.props;
const { sections, total } = await getGoCatalog();
const section = sections.find((s) => s.id === sectionId)!;

const lesson = item.status === "ready" ? loadLesson(item.slug) : undefined;
const lines = lesson ? await highlightLines(lesson.code) : [];
const steps = (lesson?.steps ?? []).map((s) => ({
  ...s,
  title: renderInline(s.title),
  html: renderMarkdown(s.body),
  snippet: renderLines(lines, { from: s.from, to: s.to, hl: true }),
  outLines: s.out ? s.out.replace(/\n$/, "").split("\n") : [],
}));
const hasVis = steps.some((s) => s.vis);
const pad = (n: number) => String(n).padStart(2, "0");
// Client data: line ranges and expected output per step.
const clientData = {
  slug: item.slug,
  steps: steps.map(({ from, to, out }) => ({ from, to, out })),
  code: lesson?.code ?? "",
  output: lesson?.output ?? "",
  next: next ? { title: next.title, href: next.href } : null,
  prev: prev ? { href: prev.href } : null,
};
// The nearest ready lesson after this one, for the "in preparation" page.
const nextReady = sections
  .flatMap((s) => s.items)
  .find((it) => it.n > item.n && it.status === "ready");
const readyInSection = section.items.filter((it) => it.status === "ready" && it.slug !== item.slug);
---

<SiteLayout
  title={`${item.title} · Go · w3hub.dev`}
  description={`Go-da ${item.title}: ${item.sub}. Azərbaycan dilində qısa izah, işlək kod və addım-addım vizual.`}
  current="go"
  lesson
  bodyClass="lx"
>
  <div class="read-progress" aria-hidden="true" slot="before-header">
    <span id="read-bar"></span>
  </div>

  <div class="lx-layout">
    <LessonSidebar sections={sections} total={total} current={item.slug} />
    <div class="lx-scrim" data-sb-close></div>

    <main class="lx-main" id="lx-main" data-slug={item.slug}>
      <nav class="lx-crumbs" aria-label="Yol">
        <a href="/">Ana səhifə</a>
        <span>/</span>
        <a href="/go/">Go</a>
        <span>/</span>
        <a href="/go/#proqram">{section.title}</a>
        <span>/</span>
        <b>{item.title}</b>
      </nav>

      {lesson ? (
        <>
          <header class="lx-head">
            <div class="lx-meta">
              <span class="mono-ic" style="--c:#00add8">
                Go
              </span>
              <span>
                {section.title} · #{pad(item.n)} / {total}
              </span>
            </div>
            <h1 class="lx-title">
              <span class="title-grad">{item.title}</span>
            </h1>
            <p class="lx-sub">{item.sub}</p>
            <div class="lx-chips">
              <span class="chip c-green">{LEVEL_LABEL[item.level]}</span>
              {item.duration && <span class="chip">{item.duration} dəq</span>}
              <span class="chip">{steps.length} addım</span>
              {hasVis && <span class="chip c-acc">vizual</span>}
              <span class="chip">{lesson.quiz.length} sual</span>
              <a class="chip c-link" href={`/go/roadmap/#${item.slug}`}>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z" />
                  <path d="M9 4v14M15 6v14" />
                </svg>
                Bu mövzu yol xəritəsində
              </a>
            </div>
            <div class="lx-actions">
              <button class="btn btn-sm" data-zen-toggle title="Zen rejimi (Z)">
                <span data-zen-label>Zen</span>
              </button>
              <button class="btn btn-sm" data-learned>
                <span data-learned-label>✓ Öyrəndim</span>
              </button>
            </div>
          </header>

          {lesson.intro && <div class="lx-lead" set:html={renderMarkdown(lesson.intro)} />}

          <div class="lx-walk">
            <div class="lx-steps" id="lx-steps">
              {steps.map((s, i) => (
                <section class="lx-step glass" data-i={i} id={`step-${s.id}`} tabindex="-1">
                  <div class="st-head">
                    <span class="st-num">{pad(i + 1)}</span>
                    <h3 set:html={s.title} />
                    <span class="st-lines">
                      sətir {s.from}
                      {s.to > s.from ? `–${s.to}` : ""}
                    </span>
                  </div>
                  <div class="st-body" set:html={s.html} />
                  <pre class="code st-snip" set:html={s.snippet} />
                  {s.vis && <Vis vis={s.vis} />}
                  {s.outLines.length > 0 && (
                    <div class="st-out">
                      <span class="p">$</span>
                      <div>
                        {s.outLines.map((o) => (
                          <span>{o}</span>
                        ))}
                      </div>
                    </div>
                  )}
                </section>
              ))}
            </div>

            <div class="lx-pane" id="lx-pane">
              <div class="cw glass dots">
                <div class="win-head cw-head">
                  <span class="win-dots">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="cw-file">main.go</span>
                  <div class="cw-steps">
                    <button
                      class="btn btn-ghost btn-sm btn-icon"
                      id="p-prev"
                      aria-label="Əvvəlki addım"
                      title="Əvvəlki addım (←)"
                    >
                      ‹
                    </button>
                    <span class="cw-count" id="p-count">
                      01 / {pad(steps.length)}
                    </span>
                    <button
                      class="btn btn-ghost btn-sm btn-icon"
                      id="p-next"
                      aria-label="Növbəti addım"
                      title="Növbəti addım (→)"
                    >
                      ›
                    </button>
                    <button
                      class="btn btn-ghost btn-sm btn-icon cw-play"
                      id="p-play"
                      aria-label="Addımları oynat"
                      title="Addımları oynat"
                    >
                      ▶
                    </button>
                  </div>
                  <button
                    class="btn btn-ghost btn-sm btn-icon"
                    id="btn-copy"
                    aria-label="Kodu kopyala"
                    title="Kopyala"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="9" y="9" width="12" height="12" rx="2" />
                      <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
                    </svg>
                  </button>
                </div>
                <div class="cw-progress">
                  <span id="cw-progress" />
                </div>
                <pre
                  class="code cw-code dim"
                  id="cw-code"
                  aria-label="main.go"
                  set:html={renderLines(lines)}
                />
                <div class="cw-term" aria-live="polite">
                  <div class="cw-term-head">
                    <span>Çıxış</span>
                    <span class="cw-status" id="cw-status">
                      <i />
                      addım rejimi
                    </span>
                    <button class="btn btn-ghost btn-sm" id="btn-full" aria-pressed="false">
                      Tam çıxış
                    </button>
                  </div>
                  <div class="cw-term-body" id="cw-term" />
                </div>
              </div>
              <div class="cw-hint">
                <span>
                  <kbd>←</kbd>
                  <kbd>→</kbd> addımlar
                </span>
                <span>
                  <kbd>Z</kbd> zen
                </span>
                <span>
                  <kbd>[</kbd> panel
                </span>
                <span>izah ↔ kod: üzərinə gəl</span>
              </div>
            </div>
          </div>

          {lesson.outro && <div class="lx-outro" set:html={renderMarkdown(lesson.outro)} />}

          <div class="lx-after">
            <Takeaways takeaways={lesson.takeaways} />
            <Quiz quiz={lesson.quiz} />
          </div>

          <div class="lx-done glass" id="lx-done">
            <div>
              <b>Dərsi bitirdin?</b>
              <small>İrəliləyiş bu brauzerdə saxlanılır</small>
            </div>
            <button class="btn btn-primary" data-learned>
              <span data-learned-label>✓ Öyrəndim</span>
            </button>
          </div>
          <script
            type="application/json"
            id="lesson-data"
            set:html={JSON.stringify(clientData).replace(/</g, "\\u003c")}
          />
        </>
      ) : (
        <>
          <section class="lx-soon glass dots" data-reveal>
            <div class="soon-orb" aria-hidden="true">
              <span />
              <span />
              <span />
            </div>
            <div class="kicker" style="justify-content:flex-start">
              lesson.Write()
              <span class="caret" />
            </div>
            <h1 class="lx-title">
              <span class="title-grad">{item.title}</span>
            </h1>
            <p class="lx-sub">
              {item.sub} · {section.title}
            </p>
            <p class="soon-text">
              Bu dərs hələ yazılır. Hər dərs orijinal nümunə ilə hazırlanır, kod Go ilə işlədilib
              yoxlanılır — ona görə bir az vaxt aparır.
            </p>
            <div class="soon-btns">
              {nextReady && (
                <a class="btn btn-primary" href={nextReady.href}>
                  Hazır dərs: {nextReady.title}
                  <i class="arrow" data-icon="arrow" />
                </a>
              )}
              <a class="btn" href="/go/#proqram">
                Bütün mövzular
              </a>
              <a class="btn btn-ghost" href={`/go/roadmap/#${item.slug}`}>
                Yol xəritəsində bax
              </a>
            </div>
            {readyInSection.length > 0 && (
              <div class="soon-ready">
                <span class="menu-label">Bu bölmədə hazırdır</span>
                <div>
                  {readyInSection.map((it) => (
                    <a class="chip" href={it.href}>
                      {it.title}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </section>
          <script
            type="application/json"
            id="lesson-data"
            set:html={JSON.stringify({ ...clientData, steps: [] }).replace(/</g, "\\u003c")}
          />
        </>
      )}

      <nav class="lx-pager" aria-label="Dərslər arasında keçid">
        {prev ? (
          <a class="glass spot" href={prev.href} data-prev>
            <span class="dir">
              ← Əvvəlki <kbd>Shift ←</kbd>
            </span>
            <b>{prev.title}</b>
            <small>{prev.sub}</small>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="glass spot next" href={next.href} data-next>
            <span class="dir">
              Növbəti → <kbd>Shift →</kbd>
            </span>
            <b>{next.title}</b>
            <small>{next.sub}</small>
          </a>
        ) : (
          <span />
        )}
      </nav>
    </main>
  </div>

  <svg class="lx-link" id="lx-link" aria-hidden="true">
    <defs>
      <linearGradient id="linkGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--accent-2)"></stop>
        <stop offset="1" stop-color="var(--cyan)"></stop>
      </linearGradient>
    </defs>
    <path id="lx-link-path"></path>
    <circle id="lx-link-a" r="3.5"></circle>
    <circle id="lx-link-b" r="3.5"></circle>
  </svg>

  <div class="zen-bar glass" role="toolbar" aria-label="Zen rejimi">
    <span class="mono-ic" style="--c:#00add8">
      Go
    </span>
    <b>{item.title}</b>
    <span class="zen-hint">
      <kbd>Esc</kbd> çıxış
    </span>
    <button class="btn btn-sm" data-zen-toggle>
      Zen-dən çıx
    </button>
  </div>

  <script>
    import "../../scripts/lesson-sidebar";
    import "../../scripts/lesson";
    import "../../scripts/quiz";
  </script>
</SiteLayout>
