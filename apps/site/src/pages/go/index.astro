---
// /go/: the Go technology page, built from the Go content collections.
import TechPage from "../../components/TechPage.astro";
import { getGoCatalog } from "../../lib/go";

const { sections, total } = await getGoCatalog();
---

<TechPage
  tech="go"
  {sections}
  {total}
  heading={["Go — sadə sintaksis,", "güclü concurrency."]}
  description={`Go-nu Azərbaycan dilində, nümunələrlə öyrən: ${sections.length} bölmə, ${total} mövzu, hər mövzuda izah, işlək kod, vizual və test.`}
  color2="#7fe3ff"
  roadmapHref="/go/roadmap/"
>
  Google-da yaranmış, server və alətlər üçün sevilən dil. Burada onu kiçik, işlək nümunələrlə
  öyrənirsən: hər mövzuda qısa izah, kod, vizual və test.
</TechPage>
