---
// Go technology page /go/ (design v2). The page is rendered at build time from the content
// collections; scripts/go-index.ts layers the visitor's progress (localStorage) on top.
import SiteLayout from "../../layouts/SiteLayout.astro";
import { DIRECTIONS, TECHS, STATUS } from "@platform/theme/data/platform";
import { getGoCatalog, LEVEL_LABEL, type GoItem } from "../../lib/go";
import "../../styles/go.css";

const { sections, total } = await getGoCatalog();
const readyCount = sections.reduce(
  (n, s) => n + s.items.filter((i) => i.status === "ready").length,
  0,
);
const pad = (i: number): string => String(i + 1).padStart(2, "0");

const dirs = DIRECTIONS.filter((d) => d.techs.includes("go"));
const backend = DIRECTIONS.find((d) => d.id === "backend")!;
const after = backend.techs
  .slice(backend.techs.indexOf("go") + 1)
  .map((id) => TECHS.find((t) => t.id === id)!);

const FACETS: [string, string][] = [
  ["book", "Nəzəriyyə"],
  ["code", "Praktika"],
  ["eye", "Vizual"],
  ["check", "Test"],
  ["chat", "Müsahibə"],
];
const ICONS: Record<string, string> = {
  book: '<path d="M4 19.5V5a2 2 0 0 1 2-2h14v15H6.5A2.5 2.5 0 0 0 4 20.5 2.5 2.5 0 0 0 6.5 23H20"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  check: '<rect x="3" y="3" width="18" height="18" rx="5"/><path d="m8 12 3 3 5-6"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/>',
};

// Initial topic state is "ready" or "soon"; the script upgrades it to "done" / "next".
const topicState = (it: GoItem): [string, string] =>
  it.status === "ready" ? ["ready", "hazır"] : ["soon", "tezliklə"];
---

<SiteLayout
  title="w3hub.dev — Go"
  description={`Go-nu Azərbaycan dilində, nümunələrlə öyrən: ${sections.length} bölmə, ${total} mövzu, hər mövzuda izah, işlək kod, vizual və test.`}
  current="go"
>
  <main data-go-index>
    <!-- ================= HERO ================= -->
    <section class="go-hero">
      <div class="go-sky" aria-hidden="true">
        <canvas class="go-aurora" id="go-aurora"></canvas>
        <div class="grid-bg"></div>
      </div>
      <div class="wrap go-hero-grid">
        <div class="go-copy">
          <nav class="crumbs" aria-label="Yol" data-reveal>
            <a href="/">Ana səhifə</a>
            <span>/</span>
            <a href="/#stack">Texnologiyalar</a>
            <span>/</span>
            <span>Go</span>
          </nav>
          <div class="go-id" data-reveal style="--i:1">
            <span class="go-mark" aria-hidden="true">
              Go
            </span>
            <div>
              <div class="kicker">
                tech.Go()<span class="caret"></span>
              </div>
              <span class="badge live">aktiv · texnologiya</span>
            </div>
          </div>
          <h1 data-reveal style="--i:2">
            <span class="title-grad">Go — sadə sintaksis,</span>
            <br />
            <span class="accent-grad">güclü concurrency.</span>
          </h1>
          <p class="go-sub" data-reveal style="--i:3">
            Google-da yaranmış, server və alətlər üçün sevilən dil. Burada onu kiçik, işlək
            nümunələrlə öyrənirsən: hər mövzuda qısa izah, kod, vizual və test.
          </p>
          <div class="go-cta" data-reveal style="--i:4">
            <a
              class="btn btn-primary btn-lg"
              id="go-continue"
              href={sections[0]?.items[0]?.href ?? "#"}
            >
              <span data-continue-label>Başla: {sections[0]?.items[0]?.title}</span>
              <i class="arrow" data-icon="arrow"></i>
            </a>
            <a class="btn btn-lg" href="/go/roadmap/">
              Yol xəritəsi
            </a>
          </div>
          <ul class="go-stats" data-reveal style="--i:5" aria-label="Go rəqəmlərlə">
            <li>
              <b>{sections.length}</b>
              <span>bölmə</span>
            </li>
            <li>
              <b>{total}</b>
              <span>mövzu</span>
            </li>
            <li>
              <b>{readyCount}</b>
              <span>dərs hazırdır</span>
            </li>
            <li>
              <b id="st-done">0</b>
              <span>öyrənilib</span>
            </li>
          </ul>
        </div>

        <aside
          class="go-resume glass dots spot"
          data-reveal="scale"
          style="--i:3"
          aria-label="İrəliləyiş"
        >
          <div class="gr-top">
            <div class="gr-ring">
              <svg viewBox="0 0 100 100">
                <defs>
                  <linearGradient id="gGo" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#7fe3ff"></stop>
                    <stop offset=".5" stop-color="#00add8"></stop>
                    <stop offset="1" stop-color="var(--accent)"></stop>
                  </linearGradient>
                </defs>
                <circle cx="50" cy="50" r="42" class="tr"></circle>
                <circle cx="50" cy="50" r="42" class="br" id="gr-bar"></circle>
              </svg>
              <b id="gr-pct">0%</b>
            </div>
            <div class="gr-next">
              <small>NÖVBƏTİ DƏRS</small>
              <a id="gr-next" href={sections[0]?.items[0]?.href ?? "#"}>
                <b id="gr-title">{sections[0]?.items[0]?.title}</b>
                <span id="gr-sub">
                  {sections[0]?.items[0]?.sub} · {sections[0]?.title}
                </span>
              </a>
            </div>
          </div>
          <div class="gr-label">Bölmələr üzrə</div>
          <ol class="gr-secs">
            {sections.map((s, i) => (
              <li data-sec-row={s.id}>
                <span class="n">{pad(i)}</span>
                <span class="t">{s.title}</span>
                <span class="b">
                  <i style="width:0%"></i>
                </span>
                <span class="c">0/{s.items.length}</span>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>

    <!-- ================= WHERE GO FITS ================= -->
    <section class="go-fit">
      <div class="wrap">
        <div class="fit glass" data-reveal>
          <div class="fit-col">
            <span class="fit-label">Bu texnologiya hansı istiqamətlərdə</span>
            <div class="fit-chips">
              {dirs.map((d) => (
                <a class="chip fit-chip" href={d.href ?? "#"}>
                  <span class="mono-ic" style={`--c:${d.c}`}>
                    {d.ic}
                  </span>
                  {d.name}
                  <span class={`badge ${STATUS[d.status][0]}`}>{STATUS[d.status][1]}</span>
                </a>
              ))}
            </div>
          </div>
          <div class="fit-col">
            <span class="fit-label">Backend yolunda Go-dan sonra</span>
            <div class="fit-chips">
              {after.map((t, i) => (
                <>
                  {i > 0 && <span class="fit-sep">→</span>}
                  <span class="chip fit-chip" title={t.desc}>
                    <span class="mono-ic" style={`--c:${t.c}`}>
                      {t.ic}
                    </span>
                    {t.name}
                  </span>
                </>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PROGRAM ================= -->
    <section class="go-program" id="proqram">
      <div class="wrap">
        <div class="prog-head">
          <div>
            <div class="kicker" data-reveal>
              go.Program()<span class="caret"></span>
            </div>
            <h2 data-reveal style="--i:1">
              <span class="title-grad">{sections.length} bölmə.</span>{" "}
              <span class="accent-grad">{total} mövzu.</span>
            </h2>
            <p data-reveal style="--i:2">
              Sadədən mürəkkəbə. Hazır dərslər açıqdır, qalanları ardıcıl əlavə olunur.
            </p>
          </div>
          <div class="seg prog-view" role="group" aria-label="Görünüş" data-reveal style="--i:3">
            <button data-view="sections" aria-pressed="true">
              Bölmələr
            </button>
            <button data-view="all" aria-pressed="false">
              Bütün mövzular
            </button>
          </div>
        </div>

        <div class="prog-sections" id="prog-sections">
          {sections.map((s, i) => {
            const ready = s.items.filter((it) => it.status === "ready").length;
            const open = i < 2;
            return (
              <article
                class:list={["sec-card glass spot", { open }]}
                data-reveal
                data-sec-card={s.id}
                style={`--i:${i % 3}`}
              >
                <div class="sc-top">
                  <span class="sc-n">{pad(i)}</span>
                  <span class="sc-lvl">{LEVEL_LABEL[s.level]}</span>
                  {ready ? (
                    <span class="badge live">{ready} hazır</span>
                  ) : (
                    <span class="badge later">tezliklə</span>
                  )}
                </div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
                <div class="sc-prog">
                  <span class="sc-bar">
                    <i style="width:0%" data-bar-done />
                    <i class="r" style={`width:${Math.round((ready / s.items.length) * 100)}%`} />
                  </span>
                  <small data-done-text>0 / {s.items.length} öyrənilib</small>
                </div>
                <button class="sc-toggle" data-sec={s.id} aria-expanded={open}>
                  {s.items.length} mövzu
                  <i data-icon="chev" />
                </button>
                <ul class="sc-topics" hidden={!open}>
                  {s.items.map((it) => {
                    const [st, tag] = topicState(it);
                    return (
                      <li>
                        <a
                          class={`topic ${st}`}
                          href={it.href}
                          data-slug={it.slug}
                          data-state={it.status}
                        >
                          <i class="td" />
                          <span>
                            <b>{it.title}</b>
                            <small>{it.sub}</small>
                          </span>
                          <em>{tag}</em>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </article>
            );
          })}
        </div>

        <div class="prog-all" id="prog-all" hidden>
          {sections.map((s, i) => (
            <div class="all-group" data-reveal>
              <div class="all-head">
                <span class="sc-n">{pad(i)}</span>
                <b>{s.title}</b>
                <small>{s.items.length} mövzu</small>
              </div>
              <ul class="all-grid">
                {s.items.map((it) => {
                  const [st, tag] = topicState(it);
                  return (
                    <li>
                      <a
                        class={`topic ${st}`}
                        href={it.href}
                        data-slug={it.slug}
                        data-state={it.status}
                      >
                        <i class="td" />
                        <span>
                          <b>{it.title}</b>
                          <small>{it.sub}</small>
                        </span>
                        <em>{tag}</em>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= FIVE FACETS STRIP ================= -->
    <section class="go-facets">
      <div class="wrap">
        <a class="facet-strip glass glow-border" href="/#model" data-reveal>
          <span class="fs-title">
            <b>Hər mövzuda 5 tərəf</b>
            <small>Necə işləyir →</small>
          </span>
          <span class="fs-items">
            {FACETS.map(([ic, t]) => (
              <span class="fs-item">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS[ic]}
                />
                {t}
              </span>
            ))}
          </span>
        </a>
      </div>
    </section>
  </main>

  <script>
    import "../../scripts/go-index";
  </script>
</SiteLayout>
