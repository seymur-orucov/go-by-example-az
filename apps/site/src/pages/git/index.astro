---
// /git/: the Git technology page, built from content/git/syllabus.yaml.
import TechPage from "../../components/TechPage.astro";
import { getSyllabusCatalog } from "../../lib/syllabus";

const { syllabus, sections, total } = getSyllabusCatalog("git");
const readyCount = sections.flatMap((s) => s.items).filter((it) => it.status === "ready").length;
---

<TechPage
  tech="git"
  {sections}
  {total}
  heading={["Git — dəyişikliklərin", "tarixçəsi, görünən."]}
  description={`Git-i Azərbaycan dilində, real komandalar və addım-addım vizual nümunələrlə öyrən: ${sections.length} modul, ${total} mövzu.`}
  badge={readyCount < total ? "başlanıb" : "aktiv"}
  unit="modul"
>
  {syllabus.audience} Hər mövzu real komandalar, onların çıxışı və repository-nin addım-addım
  vəziyyəti ilə izah olunur. <b>Hədəf:</b>
  {syllabus.level}
</TechPage>
