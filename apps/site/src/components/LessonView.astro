---
// The lesson page of any technology (/go/<slug>/, /git/<id>/). Ready lessons get the full
// walkthrough; planned topics get a short "in preparation" page so links never 404.
import LessonSidebar from "./LessonSidebar.astro";
import Quiz from "./Quiz.astro";
import Takeaways from "./Takeaways.astro";
import Vis from "./Vis.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { LEVEL_LABEL, type CatalogItem, type CatalogSection } from "../lib/catalog";
import { highlightLines, renderLines } from "../lib/highlight";
import type { Lesson, Vis as VisData } from "../lib/lesson";
import { renderMarkdown } from "../lib/markdown";

interface Props {
  /** "go", "git": the zen bar mark. */
  techId: string;
  techTitle: string;
  techHref: string;
  /** The header's technology switcher only knows Go so far. */
  layoutTech?: "go";
  title: string;
  description: string;
  item: CatalogItem;
  section: CatalogSection;
  sections: CatalogSection[];
  total: number;
  prev?: CatalogItem;
  next?: CatalogItem;
  lesson?: Lesson;
  /** What the "in preparation" page promises. */
  soon?: string;
}

const {
  techId,
  techTitle,
  techHref,
  layoutTech,
  title,
  description,
  item,
  section,
  sections,
  total,
  prev,
  next,
  lesson,
  soon = "qısa izah, işlək kod, addım-addım vizual və özünü yoxlamaq üçün suallar",
} = Astro.props;

const VIS_LABEL: Record<VisData["kind"], string> = { slice: "Yaddaş", areas: "Üç sahə" };

const lines = lesson ? await highlightLines(lesson.code, lesson.lang) : [];
const steps = (lesson?.steps ?? []).map((s) => ({
  ...s,
  html: renderMarkdown(s.body),
  snippet: renderLines(lines, s),
}));
const hasVis = steps.some((s) => s.vis);
// Client data: line ranges and expected output per step.
const clientData = {
  slug: item.slug,
  steps: steps.map(({ from, to, out }) => ({ from, to, out })),
  code: lesson?.code ?? "",
  output: lesson?.output ?? "",
  run: lesson?.run ?? null,
  copied: lesson?.lang === "bash" ? "Komandalar kopyalandı" : "Kod kopyalandı",
  next: next ? { title: next.title, href: next.href } : null,
};
// The nearest ready lesson after this one, for the "in preparation" page.
const nextReady = sections
  .flatMap((s) => s.items)
  .find((it) => it.n > item.n && it.status === "ready");
---

<SiteLayout title={title} description={description} tech={layoutTech} lesson>
  <div class="layout">
    <LessonSidebar sections={sections} total={total} current={item.slug} />

    <main class="article" data-slug={item.slug}>
      <nav class="crumbs" aria-label="Yol">
        <a href="/">Ana səhifə</a>
        <span class="sep">/</span>
        <a href={techHref}>{techTitle}</a>
        <span class="sep">/</span>
        <a href={`${techHref}#proqram`}>{section.title}</a>
        <span class="sep">/</span>
        <span>{item.title}</span>
      </nav>
      <div class="lesson-head">
        <h1>
          {item.title} <small>{item.sub}</small>
        </h1>
        {lesson && (
          <div class="lesson-actions">
            <button class="btn btn-sm btn-zen" data-zen-toggle title="Zen rejimi (Z)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" />
              </svg>
              <span data-zen-label>Zen</span>
            </button>
            <button class="btn btn-sm" data-learned>
              ✓ <span>Öyrəndim</span>
            </button>
          </div>
        )}
      </div>
      <div class="chips">
        <span class="chip green">{LEVEL_LABEL[item.level]}</span>
        {item.duration && <span class="chip">{item.duration} dəq</span>}
        <span class="chip">
          #{String(item.n).padStart(2, "0")} / {total}
        </span>
        {hasVis && <span class="chip acc">vizual</span>}
        {!lesson && <span class="chip">hazırlanır</span>}
      </div>

      {lesson ? (
        <>
          {lesson.intro && <div class="lead" set:html={renderMarkdown(lesson.intro)} />}

          <div class="walkthrough">
            <div class="steps" id="steps">
              {steps.map((s, i) => (
                <section class="step" data-step={s.id} id={`addim-${s.id}`}>
                  <span class="num">{i + 1}</span>
                  <h3>{s.title}</h3>
                  <div class="step-body" set:html={s.html} />
                  <pre class="code snippet" set:html={s.snippet} />
                  {s.vis && (
                    <div class="step-vis">
                      <div class="step-vis-cap">
                        <span class="label">{VIS_LABEL[s.vis.kind]}</span>
                      </div>
                      <Vis vis={s.vis} />
                    </div>
                  )}
                </section>
              ))}
            </div>

            <div class="sticky-pane" id="pane">
              <div class="code-window">
                <div class="cw-bar">
                  <span class="cw-file">
                    {lesson.lang === "go" ? (
                      <span class="gofile">GO</span>
                    ) : (
                      <span class="gofile shfile">$_</span>
                    )}
                    {lesson.file}
                  </span>
                  <div class="cw-actions">
                    <div class="cw-steps" aria-label="Addımlar">
                      <button
                        class="btn btn-ghost btn-sm btn-icon"
                        data-prev-step
                        title="Əvvəlki addım (←)"
                        aria-label="Əvvəlki addım"
                      >
                        ‹
                      </button>
                      <span class="count" data-step-count />
                      <button
                        class="btn btn-ghost btn-sm btn-icon"
                        data-next-step
                        title="Növbəti addım (→)"
                        aria-label="Növbəti addım"
                      >
                        ›
                      </button>
                      <button
                        class="btn btn-ghost btn-sm btn-icon"
                        data-play
                        title="Addımları oynat"
                        aria-label="Addımları oynat"
                      />
                    </div>
                    <button
                      class="btn btn-ghost btn-sm btn-icon"
                      data-copy
                      title="Kopyala"
                      aria-label="Kodu kopyala"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="9" y="9" width="12" height="12" rx="2" />
                        <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
                      </svg>
                    </button>
                    <button
                      class="btn btn-primary btn-sm"
                      data-run
                      title={`${lesson.run ? "Proqramın" : "Sessiyanın"} tam çıxışını göstər (Ctrl+Enter)`}
                    >
                      ▶ <span class="txt">Tam çıxış</span>
                    </button>
                  </div>
                </div>
                <pre class="code" id="code" set:html={renderLines(lines)} />
                <div class="terminal" aria-live="polite">
                  <div class="pane-head">
                    <span class="label">Çıxış</span>
                    <span class="status" data-run-status>
                      <span class="led" />
                      <span>addım rejimi</span>
                    </span>
                  </div>
                  <div class="term-body" data-term />
                </div>
              </div>
              <div class="hint">
                <span>
                  <kbd>←</kbd>
                  <kbd>→</kbd> addımlar
                </span>
                <span>
                  <kbd>Ctrl</kbd>
                  <kbd>↵</kbd> tam çıxış
                </span>
                <span>
                  <kbd>Z</kbd> zen
                </span>
                <span>izah ↔ kod: üzərinə gəl</span>
              </div>
            </div>
          </div>

          {lesson.outro && <div class="lesson-outro" set:html={renderMarkdown(lesson.outro)} />}

          <div class="after">
            <Takeaways takeaways={lesson.takeaways} />
            <Quiz quiz={lesson.quiz} lang={lesson.lang} />
          </div>
          <script
            type="application/json"
            id="lesson-data"
            set:html={JSON.stringify(clientData).replace(/</g, "\\u003c")}
          />
        </>
      ) : (
        <section class="card lesson-soon">
          <span class="label">Hazırlanır</span>
          <h2>Bu mövzunun dərsi hələ yazılır</h2>
          <p>
            “{item.title}” dərsi tezliklə burada olacaq: {soon}.
          </p>
          <div class="hero-cta">
            {nextReady && (
              <a class="btn btn-primary" href={nextReady.href}>
                Hazır dərs: {nextReady.title} →
              </a>
            )}
            <a class="btn" href={`${techHref}#proqram`}>
              Bütün mövzular
            </a>
          </div>
        </section>
      )}

      <nav class="pager" aria-label="Nümunələr arasında keçid">
        {prev ? (
          <a href={prev.href} data-prev>
            <span class="dir">
              <span>← Əvvəlki</span>
              <kbd>Shift ←</kbd>
            </span>
            <b>{prev.title}</b>
            <small>{prev.sub}</small>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="next" href={next.href} data-next>
            <span class="dir">
              <span>Növbəti →</span>
              <kbd>Shift →</kbd>
            </span>
            <b>{next.title}</b>
            <small>{next.sub}</small>
          </a>
        )}
      </nav>
    </main>
  </div>

  <div class="read-progress" aria-hidden="true">
    <span></span>
  </div>
  <div class="zen-bar" role="toolbar" aria-label="Zen rejimi">
    <span class="logo-mark">{techId}</span>
    <b>{item.title}</b>
    <span class="sep"></span>
    <span class="zen-hint">
      <kbd>Esc</kbd> çıxış
    </span>
    <button class="btn btn-ghost btn-sm" data-zen-toggle title="Zen rejimindən çıx (Esc)">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3"></path>
      </svg>
      Çıx
    </button>
  </div>
</SiteLayout>

<script>
  import "../scripts/lesson-sidebar";
  import "../scripts/lesson";
  import "../scripts/quiz";
</script>
