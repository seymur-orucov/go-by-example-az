---
// "Özünü yoxla": the questions of quiz.<locale>.yaml as a slider, one question at a time, with
// progress dots and a result slide (design v2). Behavior: scripts/quiz.ts. The explanation of a
// question is stored in a <template> and shown after the right answer.
import { highlightLines, renderLines, type Lang } from "../lib/highlight";
import type { QuizQuestion } from "../lib/lesson";
import { renderInline } from "../lib/markdown";

interface Props {
  quiz: QuizQuestion[];
  /** Language of the questions' code snippets. */
  lang?: Lang;
}

const { quiz, lang = "go" } = Astro.props;
const LETTERS = "ABCDE";
const total = quiz.length;
const questions = await Promise.all(
  quiz.map(async (q) => ({
    question: renderInline(q.question),
    code: q.code ? renderLines(await highlightLines(q.code, lang)) : undefined,
    options: q.options.map(renderInline),
    answer: q.answer,
    explain: q.explain ? renderInline(q.explain) : "",
  })),
);
---

<section
  class="qz glass glow-border"
  data-quiz
  data-reveal
  style="--i:1"
  aria-labelledby="qz-h"
  id="quiz"
  tabindex="-1"
>
  <div class="qz-head">
    <div>
      <div class="kicker" style="justify-content:flex-start">
        Özünü yoxla
      </div>
      <h2 id="qz-h">
        Test · <span data-quiz-n>1</span> / {total}
      </h2>
    </div>
    <div class="qz-dots" role="tablist" aria-label="Suallar">
      {questions.map((_, k) => (
        <button role="tab" data-k={k} aria-label={`Sual ${k + 1}`} />
      ))}
      <button role="tab" data-k={total} class="qz-dot-end" aria-label="Nəticə"></button>
    </div>
  </div>
  <div class="qz-view" data-quiz-view>
    <div class="qz-track" data-quiz-track>
      {questions.map((q, k) => (
        <div class="qz-slide" data-k={k} data-answer={q.answer}>
          <p class="qz-q" set:html={q.question} />
          {q.code && <pre class="code qz-code" set:html={q.code} />}
          <div class="qz-opts">
            {q.options.map((o, n) => (
              <button class="qz-opt" data-n={n}>
                <span class="qz-letter">{LETTERS[n]}</span>
                <span class="mono" set:html={o} />
              </button>
            ))}
          </div>
          <p class="qz-fb" aria-live="polite" />
          <template set:html={q.explain} />
        </div>
      ))}
      <div class="qz-slide qz-result" data-k={total}>
        <div class="qz-ring">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <defs>
              <linearGradient id="qzGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="var(--cyan)"></stop>
                <stop offset=".5" stop-color="var(--accent)"></stop>
                <stop offset="1" stop-color="var(--accent-2)"></stop>
              </linearGradient>
            </defs>
            <circle cx="60" cy="60" r="50" class="tr"></circle>
            <circle cx="60" cy="60" r="50" class="br" data-quiz-bar></circle>
          </svg>
          <div>
            <b data-quiz-score>0/{total}</b>
            <small>ilk cəhddə</small>
          </div>
        </div>
        <h3 data-quiz-verdict></h3>
        <p class="muted" data-quiz-verdict-sub></p>
        <button class="btn btn-primary" data-quiz-restart>
          Yenidən başla
        </button>
      </div>
    </div>
  </div>
  <div class="qz-foot">
    <button class="btn btn-sm" data-quiz-prev>
      ‹ Əvvəlki
    </button>
    <button class="btn btn-sm" data-quiz-next>
      Növbəti ›
    </button>
  </div>
</section>
