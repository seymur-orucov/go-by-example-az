---
// "Özünü yoxla": the questions of quiz.<locale>.yaml as a slider, one question at a time,
// with progress dots and a result slide at the end. Behavior: scripts/quiz.ts.
import { highlightLines, renderLines, type Lang } from "../lib/highlight";
import type { QuizQuestion } from "../lib/lesson";
import { renderInline } from "../lib/markdown";

interface Props {
  quiz: QuizQuestion[];
  /** Language of the questions' code snippets. */
  lang?: Lang;
}

const { quiz, lang = "go" } = Astro.props;
const LETTERS = "ABCDE";
const total = quiz.length;
const questions = await Promise.all(
  quiz.map(async (q) => ({
    question: renderInline(q.question),
    code: q.code ? renderLines(await highlightLines(q.code, lang)) : undefined,
    options: q.options.map(renderInline),
    answer: q.answer,
    explain: q.explain ? renderInline(q.explain) : "",
  })),
);
---

<section
  class="card quiz quiz-slider"
  id="quiz"
  data-quiz
  aria-labelledby="quiz-title"
  tabindex="-1"
>
  <div class="quiz-head">
    <div>
      <span class="label">Özünü yoxla</span>
      <h2 id="quiz-title">{total} sual</h2>
    </div>
    <span class="quiz-count" data-quiz-count aria-live="polite">
      1 / {total}
    </span>
  </div>

  <div class="quiz-dots" aria-label="Suallar">
    {questions.map((_, i) => (
      <button
        type="button"
        class="quiz-dot"
        data-quiz-go={i}
        aria-label={`Sual ${i + 1}`}
        aria-current={i === 0 ? "step" : undefined}
      />
    ))}
  </div>

  <div class="quiz-viewport" data-quiz-viewport>
    <ol class="quiz-track" data-quiz-track>
      {questions.map((q, qi) => (
        <li
          class="quiz-q"
          data-answer={q.answer}
          aria-label={`Sual ${qi + 1} / ${total}`}
          inert={qi > 0 || undefined}
        >
          <p class="quiz-question" set:html={q.question} />
          {q.code && <pre class="code" set:html={q.code} />}
          <div class="quiz-options" role="group" aria-label="Cavablar">
            {q.options.map((o, oi) => (
              <button class="quiz-option" type="button" data-i={oi}>
                <span class="letter">{LETTERS[oi]}</span>
                <span set:html={o} />
              </button>
            ))}
          </div>
          <p class="quiz-feedback" aria-live="polite" />
          <template set:html={q.explain} />
        </li>
      ))}
      <li class="quiz-q quiz-result" data-quiz-result inert>
        <div class="quiz-ring" data-quiz-ring>
          <b data-quiz-score>0</b>
          <small>/ {total}</small>
        </div>
        <p class="quiz-result-title" data-quiz-verdict></p>
        <p class="quiz-result-sub">İlk cəhddə düz cavablanan suallar.</p>
        <button type="button" class="btn" data-quiz-restart>
          Yenidən başla
        </button>
      </li>
    </ol>
  </div>

  <div class="quiz-nav">
    <button type="button" class="btn btn-ghost btn-sm" data-quiz-prev disabled>
      ‹ Əvvəlki
    </button>
    <span class="quiz-hint">
      <kbd>←</kbd>
      <kbd>→</kbd> suallar
    </span>
    <button type="button" class="btn btn-sm" data-quiz-next>
      Növbəti ›
    </button>
  </div>
</section>
