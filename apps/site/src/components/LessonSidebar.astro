---
// Lesson sidebar (design v2): progress card and collapsible section groups. Learned marks,
// counts and the progress bar are painted from localStorage by scripts/lesson-sidebar.ts.
import type { CatalogSection } from "../lib/catalog";

interface Props {
  sections: CatalogSection[];
  total: number;
  current: string;
  /** The technology the course belongs to: label, color and its roadmap page (if it has one). */
  techName?: string;
  techColor?: string;
  roadmapHref?: string;
}

const {
  sections,
  total,
  current,
  techName = "Go",
  techColor = "#00add8",
  roadmapHref,
} = Astro.props;
---

<aside class="lx-side" id="lx-side" aria-label={`${techName} mövzuları`} data-lesson-sidebar>
  <div class="sb-card glass dots">
    <span class="mono-ic" style={`--c:${techColor}`}>
      {techName}
    </span>
    <div>
      <b>{techName} yolu</b>
      <small>
        <b data-sb-done>0</b> / {total} dərs · <span data-sb-pct>0</span>%
      </small>
    </div>
    {roadmapHref && (
      <a class="sb-map" href={roadmapHref} title="Yol xəritəsi" aria-label="Yol xəritəsi">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"></path>
          <path d="M9 4v14M15 6v14"></path>
        </svg>
      </a>
    )}
    <div class="sb-bar">
      <span data-sb-bar style="width:0%"></span>
    </div>
  </div>
  <nav class="sb-nav" aria-label="Bölmələr">
    {sections.map((s, si) => (
      <details class="sb-group" open={s.items.some((it) => it.slug === current) || undefined}>
        <summary>
          <span class="sb-n">{String(si + 1).padStart(2, "0")}</span>
          {s.title}
          <span class="sb-cnt" data-sb-count={s.items.map((it) => it.slug).join(" ")}>
            0/{s.items.length}
          </span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <ul class="sb-list">
          {s.items.map((it) => (
            <li>
              <a
                class={it.status === "ready" ? "ready" : "plan"}
                href={it.href}
                data-slug={it.slug}
                data-state={it.status}
                aria-current={it.slug === current ? "page" : undefined}
              >
                <span class="sb-dot" aria-hidden="true" />
                {it.title}
                <span class="sb-ok" aria-label="öyrənildi" hidden>
                  ✓
                </span>
                {it.status !== "ready" && <span class="sb-soon">tezliklə</span>}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </nav>
</aside>
