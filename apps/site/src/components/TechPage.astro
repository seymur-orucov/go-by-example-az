---
// The technology page (/go/, /git/, ...): hero with the aurora tinted in the technology's
// color, the progress card, "where it fits", the program (section cards / all topics) and the
// five-facets strip. Built at build time from the catalog; scripts/tech-index.ts layers the
// visitor's progress (localStorage) on top.
import SiteLayout from "../layouts/SiteLayout.astro";
import { DIRECTIONS, TECHS, STATUS } from "@platform/theme/data/platform";
import { LEVEL_LABEL, type CatalogItem, type CatalogSection } from "../lib/catalog";
import "../styles/tech.css";

interface Props {
  /** Technology id from `TECHS` (route prefix and localStorage key part). */
  tech: string;
  sections: CatalogSection[];
  total: number;
  /** The two hero title lines. */
  heading: [string, string];
  /** Meta description of the page. */
  description: string;
  /** Badge next to the mark, before "· texnologiya". */
  badge?: string;
  /** What a section is called: "bölmə" (Go) or "modul" (syllabus technologies). */
  unit?: string;
  /** The name with the ablative suffix ("Go-dan", "Git-dən"); the vowel rule fails for acronyms. */
  nameFrom?: string;
  /** Lighter shade of the technology color for the aurora and the ring; mixed with white by default. */
  color2?: string;
  roadmapHref?: string;
}

const {
  tech,
  sections,
  total,
  heading,
  description,
  badge = "aktiv",
  unit = "bölmə",
  color2,
  roadmapHref,
} = Astro.props;

const info = TECHS.find((t) => t.id === tech);
if (!info) throw new Error(`TechPage: unknown technology "${tech}"`);
const { name, c: color } = info;

/** Mixes a #rrggbb color with white (the aurora reads plain rgb, not color-mix()). */
const tint = (hex: string, w: number): string =>
  "#" +
  [1, 3, 5]
    .map((i) => {
      const v = parseInt(hex.slice(i, i + 2), 16);
      return Math.round(v + (255 - v) * w)
        .toString(16)
        .padStart(2, "0");
    })
    .join("");
const ice = color2 ?? tint(color, 0.5);

const back = /[aıou][^aıoueəiöü]*$/i.test(name);
const nameFrom = Astro.props.nameFrom ?? `${name}-${back ? "dan" : "dən"}`;

const all = sections.flatMap((s) => s.items);
const readyCount = all.filter((it) => it.status === "ready").length;
const first = all.find((it) => it.status === "ready") ?? all[0];
const minutes = all.reduce((m, it) => m + (it.duration ?? 0), 0);
// 267 minutes -> "~4,5 saat" (nearest half hour, Azerbaijani decimal comma)
const hours = minutes
  ? `~${(Math.round((minutes / 60) * 2) / 2).toString().replace(".", ",")} saat`
  : "";
const pad = (i: number): string => String(i + 1).padStart(2, "0");

/** The part heading to show before section i: only where a new part starts (large syllabi). */
const partStart = (i: number) => {
  const part = sections[i]?.part;
  if (!part || part.id === sections[i - 1]?.part?.id) return null;
  const own = sections.filter((s) => s.part?.id === part.id);
  return { ...part, modules: own.length, topics: own.reduce((n, s) => n + s.items.length, 0) };
};

const dirs = DIRECTIONS.filter((d) => d.techs.includes(tech));
const path = dirs[0];
const after = path
  ? path.techs
      .slice(path.techs.indexOf(tech) + 1)
      .map((id) => TECHS.find((t) => t.id === id))
      .filter((t) => t !== undefined)
  : [];

const FACETS: [string, string][] = [
  ["book", "Nəzəriyyə"],
  ["code", "Praktika"],
  ["eye", "Vizual"],
  ["check", "Test"],
  ["chat", "Müsahibə"],
];
const ICONS: Record<string, string> = {
  book: '<path d="M4 19.5V5a2 2 0 0 1 2-2h14v15H6.5A2.5 2.5 0 0 0 4 20.5 2.5 2.5 0 0 0 6.5 23H20"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  check: '<rect x="3" y="3" width="18" height="18" rx="5"/><path d="m8 12 3 3 5-6"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/>',
};

// Initial topic state is "ready" or "soon"; the script upgrades it to "done" / "next".
const topicState = (it: CatalogItem): [string, string] =>
  it.status === "ready" ? ["ready", "hazır"] : ["soon", "tezliklə"];
const techVars = `:root{--tech-c:${color};--tech-c-2:${ice}}`;
---

<SiteLayout title={`stackrise.dev — ${name}`} description={description} current={tech}>
  <style is:inline set:html={techVars}></style>
  <main data-tech-index={tech}>
    <!-- ================= HERO ================= -->
    <section class="tech-hero">
      <div class="tech-sky" aria-hidden="true">
        <canvas class="tech-aurora" id="tech-aurora"></canvas>
        <div class="grid-bg"></div>
      </div>
      <div class="wrap tech-hero-grid">
        <div class="tech-copy">
          <nav class="crumbs" aria-label="Yol" data-reveal>
            <a href="/">Ana səhifə</a>
            <span>/</span>
            <a href="/#stack">Texnologiyalar</a>
            <span>/</span>
            <span>{name}</span>
          </nav>
          <div class="tech-id" data-reveal style="--i:1">
            <span class="tech-mark" aria-hidden="true">
              {info.ic}
            </span>
            <div>
              <div class="kicker">
                tech.{name}()<span class="caret"></span>
              </div>
              <span class="badge live">{badge} · texnologiya</span>
            </div>
          </div>
          <h1 data-reveal style="--i:2">
            <span class="title-grad">{heading[0]}</span>
            <br />
            <span class="accent-grad">{heading[1]}</span>
          </h1>
          <p class="tech-sub" data-reveal style="--i:3">
            <slot />
          </p>
          <div class="tech-cta" data-reveal style="--i:4">
            <a class="btn btn-primary btn-lg" id="tech-continue" href={first?.href ?? "#"}>
              <span data-continue-label>Başla: {first?.title}</span>
              <i class="arrow" data-icon="arrow"></i>
            </a>
            {roadmapHref ? (
              <a class="btn btn-lg" href={roadmapHref}>
                Yol xəritəsi
              </a>
            ) : (
              <a class="btn btn-lg" href="#proqram">
                Bütün mövzular
              </a>
            )}
          </div>
          <ul class="tech-stats" data-reveal style="--i:5" aria-label={`${name} rəqəmlərlə`}>
            <li>
              <b>{sections.length}</b>
              <span>{unit}</span>
            </li>
            <li>
              <b>{total}</b>
              <span>mövzu</span>
            </li>
            <li>
              <b>{readyCount}</b>
              <span>dərs hazırdır</span>
            </li>
            <li>
              <b id="st-done">0</b>
              <span>öyrənilib</span>
            </li>
          </ul>
        </div>

        <aside
          class="tech-resume glass dots spot"
          data-reveal="scale"
          style="--i:3"
          aria-label="İrəliləyiş"
        >
          <div class="gr-top">
            <div class="gr-ring">
              <svg viewBox="0 0 100 100">
                <defs>
                  <linearGradient id="gTech" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="var(--tech-c-2)"></stop>
                    <stop offset=".5" stop-color="var(--tech-c)"></stop>
                    <stop offset="1" stop-color="var(--accent)"></stop>
                  </linearGradient>
                </defs>
                <circle cx="50" cy="50" r="42" class="tr"></circle>
                <circle cx="50" cy="50" r="42" class="br" id="gr-bar"></circle>
              </svg>
              <b id="gr-pct">0%</b>
            </div>
            <div class="gr-next">
              <small>NÖVBƏTİ DƏRS</small>
              <a id="gr-next" href={first?.href ?? "#"}>
                <b id="gr-title">{first?.title}</b>
                <span id="gr-sub">
                  {first?.sub || (first?.duration ? `${first.duration} dəq` : "")} ·{" "}
                  {sections.find((s) => s.items.includes(first!))?.title}
                </span>
              </a>
            </div>
          </div>
          <div class="gr-label">
            {unit === "modul" ? "Modullar" : "Bölmələr"} üzrə{hours && ` · ${hours}`}
          </div>
          <ol class="gr-secs">
            {sections.map((s, i) => (
              <li data-sec-row={s.id}>
                <span class="n">{pad(i)}</span>
                <span class="t">{s.title}</span>
                <span class="b">
                  <i style="width:0%" />
                </span>
                <span class="c">0/{s.items.length}</span>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>

    <!-- ================= WHERE IT FITS ================= -->
    {dirs.length > 0 && (
      <section class="tech-fit">
        <div class="wrap">
          <div class="fit glass" data-reveal>
            <div class="fit-col">
              <span class="fit-label">Bu texnologiya hansı istiqamətlərdə</span>
              <div class="fit-chips">
                {dirs.map((d) => (
                  <a class="chip fit-chip" href={d.href ?? "#"}>
                    <span class="mono-ic" style={`--c:${d.c}`}>
                      {d.ic}
                    </span>
                    {d.name}
                    <span class={`badge ${STATUS[d.status][0]}`}>{STATUS[d.status][1]}</span>
                  </a>
                ))}
              </div>
            </div>
            {after.length > 0 && (
              <div class="fit-col">
                <span class="fit-label">
                  {path!.name} yolunda {nameFrom} sonra
                </span>
                <div class="fit-chips">
                  {after.map((t, i) => (
                    <>
                      {i > 0 && <span class="fit-sep">→</span>}
                      <span class="chip fit-chip" title={t.desc}>
                        <span class="mono-ic" style={`--c:${t.c}`}>
                          {t.ic}
                        </span>
                        {t.name}
                      </span>
                    </>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- ================= PROGRAM ================= -->
    <section class="tech-program" id="proqram">
      <div class="wrap">
        <div class="prog-head">
          <div>
            <div class="kicker" data-reveal>
              {tech}.Program()<span class="caret"></span>
            </div>
            <h2 data-reveal style="--i:1">
              <span class="title-grad">
                {sections.length} {unit}.
              </span>{" "}
              <span class="accent-grad">{total} mövzu.</span>
            </h2>
            <p data-reveal style="--i:2">
              Sadədən mürəkkəbə. Hazır dərslər açıqdır, qalanları ardıcıl əlavə olunur.
            </p>
          </div>
          <div class="seg prog-view" role="group" aria-label="Görünüş" data-reveal style="--i:3">
            <button data-view="sections" aria-pressed="true">
              {unit === "modul" ? "Modullar" : "Bölmələr"}
            </button>
            <button data-view="all" aria-pressed="false">
              Bütün mövzular
            </button>
          </div>
        </div>

        <div class="prog-sections" id="prog-sections">
          {sections.map((s, i) => {
            const ready = s.items.filter((it) => it.status === "ready").length;
            const open = i < 2;
            const part = partStart(i);
            return (
              <>
                {part && (
                  <div class="prog-part" data-reveal>
                    <h3>{part.title}</h3>
                    <p>{part.description}</p>
                    <small>
                      {part.modules} {unit} · {part.topics} mövzu
                    </small>
                  </div>
                )}
                <article
                  class:list={["sec-card glass spot", { open }]}
                  data-reveal
                  data-sec-card={s.id}
                  style={`--i:${i % 3}`}
                >
                  <div class="sc-top">
                    <span class="sc-n">{pad(i)}</span>
                    <span class="sc-lvl">{LEVEL_LABEL[s.level]}</span>
                    {ready ? (
                      <span class="badge live">{ready} hazır</span>
                    ) : (
                      <span class="badge later">tezliklə</span>
                    )}
                  </div>
                  <h3>{s.title}</h3>
                  <p>{s.description}</p>
                  <div class="sc-prog">
                    <span class="sc-bar">
                      <i style="width:0%" data-bar-done />
                      <i class="r" style={`width:${Math.round((ready / s.items.length) * 100)}%`} />
                    </span>
                    <small data-done-text>0 / {s.items.length} öyrənilib</small>
                  </div>
                  <button class="sc-toggle" data-sec={s.id} aria-expanded={open}>
                    {s.items.length} mövzu
                    <i data-icon="chev" />
                  </button>
                  <ul class="sc-topics" hidden={!open}>
                    {s.items.map((it) => {
                      const [st, tag] = topicState(it);
                      return (
                        <li>
                          <a
                            class={`topic ${st}`}
                            href={it.href}
                            data-slug={it.slug}
                            data-state={it.status}
                          >
                            <i class="td" />
                            <span>
                              <b>{it.title}</b>
                              <small>{it.sub || (it.duration ? `${it.duration} dəq` : "")}</small>
                            </span>
                            <em>{tag}</em>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </article>
              </>
            );
          })}
        </div>

        <div class="prog-all" id="prog-all" hidden>
          {sections.map((s, i) => (
            <>
              {partStart(i) && (
                <div class="prog-part" data-reveal>
                  <h3>{partStart(i)!.title}</h3>
                </div>
              )}
              <div class="all-group" data-reveal>
                <div class="all-head">
                  <span class="sc-n">{pad(i)}</span>
                  <b>{s.title}</b>
                  <small>{s.items.length} mövzu</small>
                </div>
                <ul class="all-grid">
                  {s.items.map((it) => {
                    const [st, tag] = topicState(it);
                    return (
                      <li>
                        <a
                          class={`topic ${st}`}
                          href={it.href}
                          data-slug={it.slug}
                          data-state={it.status}
                        >
                          <i class="td" />
                          <span>
                            <b>{it.title}</b>
                            <small>{it.sub || (it.duration ? `${it.duration} dəq` : "")}</small>
                          </span>
                          <em>{tag}</em>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= FIVE FACETS STRIP ================= -->
    <section class="tech-facets">
      <div class="wrap">
        <a class="facet-strip glass glow-border" href="/#model" data-reveal>
          <span class="fs-title">
            <b>Hər mövzuda 5 tərəf</b>
            <small>Necə işləyir →</small>
          </span>
          <span class="fs-items">
            {FACETS.map(([ic, t]) => (
              <span class="fs-item">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS[ic]}
                />
                {t}
              </span>
            ))}
          </span>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  import "../scripts/tech-index";
</script>
