---
// Memory visual of a lesson step (design v2). One branch per `vis.kind` (see visSchema in
// lib/lesson.ts). The script adds the `pop` animation to the cells marked `new` when the step
// becomes active.
import type { Vis } from "../lib/lesson";

interface Props {
  vis: Vis;
}

const { vis } = Astro.props;
const shown = (v: string | undefined) =>
  v === undefined || v === "" ? "·" : /^\d+$/.test(v) ? v : `"${v}"`;
const count = Math.max(vis.cap, vis.cells.length);
const cells = Array.from({ length: count }, (_, k) => {
  const inLen = vis.window ? k >= vis.window[0] && k < vis.window[1] : k < vis.len;
  const isNew = !!vis.fresh?.includes(k) && inLen;
  return { k, inLen, isNew, text: shown(vis.cells[k]) };
});
---

{vis.kind === "slice" && (
  <div class="st-vis">
    <div class="st-vis-cap">
      <span>Yaddaş</span>
      <small class="mono">
        len {vis.len} · cap {vis.cap}
      </small>
    </div>
    <div class="vis">
      <div class="vis-row">
        <span class="vis-name">{vis.name}</span>
        <div class="cells">
          {vis.nil ? (
            <span class="cell cap">nil</span>
          ) : (
            cells.map((c) => (
              <span class="vcell">
                <span
                  class:list={["cell", c.inLen ? "on" : "cap", { new: c.isNew }]}
                  style={`--d:${c.k * 70}ms`}
                >
                  {c.text}
                </span>
                <small>{c.k}</small>
              </span>
            ))
          )}
        </div>
      </div>
      {vis.window && (
        <p class="vis-note">
          eyni array, fərqli pəncərə: <code>{vis.name}</code> {vis.window[0]}–{vis.window[1] - 1}{" "}
          indekslərini görür
        </p>
      )}
    </div>
  </div>
)}
