---
// Visual of a lesson step (design v2). One branch per `vis.kind` (see Vis in lib/lesson.ts):
// - slice: memory cells; the script adds the `pop` animation to the cells marked `new` when the
//   step becomes active;
// - map: key → value rows; added or changed keys in green, deleted keys struck through, and an
//   optional `v, ok := m[key]` read (shown as m[key] → value, ok);
// - channel: sender → buffer slots (one hand-to-hand slot when unbuffered) → receiver, with the
//   values the receiver took and who had to wait;
// - timeline: goroutines on a time axis (sequential vs concurrent, cut off when main returns);
// - areas: the three areas of a Git repository, recorded by `pnpm content:run`.
// The script replays the `pop` animation of `.cell.new` and `.tl-bar` when a step becomes active.
import type { Vis, VisAreas } from "../lib/lesson";

interface Props {
  vis: Vis;
}

const { vis } = Astro.props;

// ---- slice
const slice = vis.kind === "slice" ? vis : null;
const shown = (v: string | undefined) =>
  v === undefined || v === "" ? "·" : /^\d+$/.test(v) ? v : `"${v}"`;
const cells = slice
  ? Array.from({ length: Math.max(slice.cap, slice.cells.length) }, (_, k) => {
      const inLen = slice.window ? k >= slice.window[0] && k < slice.window[1] : k < slice.len;
      const isNew = !!slice.fresh?.includes(k) && inLen;
      return { k, inLen, isNew, text: shown(slice.cells[k]) };
    })
  : [];

// ---- map: every key in Go's print order (sorted), deleted ones included where they were
const map = vis.kind === "map" ? vis : null;
const quoted = (v: string) => (/^-?\d+(\.\d+)?$|^(true|false)$/.test(v) ? v : `"${v}"`);
const mapRows = map
  ? [
      ...Object.entries(map.entries).map(([k, v]) => ({
        k,
        v,
        fresh: !!map.fresh?.includes(k),
        gone: false,
      })),
      ...(map.gone ?? []).map((k) => ({ k, v: "", fresh: false, gone: true })),
    ].sort((a, b) => (a.k < b.k ? -1 : a.k > b.k ? 1 : 0))
  : [];

// ---- channel
const chan = vis.kind === "channel" ? vis : null;
const slots = chan
  ? Array.from({ length: Math.max(chan.cap, 1) }, (_, i) => ({
      text: chan.buf[i],
      isNew: !!chan.fresh?.includes(i),
    }))
  : [];

// ---- timeline
const tl = vis.kind === "timeline" ? vis : null;
const pct = (ms: number) => `${tl ? (ms / tl.total) * 100 : 0}%`;
const ticks = tl
  ? Array.from({ length: Math.floor(tl.total / 100) + 1 }, (_, i) => i * 100).filter(
      (t) => t <= tl.total,
    )
  : [];
const TL_STATE = { work: "işləyir", wait: "gözləyir", cut: "kəsildi" } as const;
const TL_LEGEND = { ...TL_STATE, cut: "main bitəndə kəsildi" } as const;
// the legend lists only the states the step shows
const tlStates = tl
  ? (["work", "wait", "cut"] as const).filter((s) =>
      tl.rows.some((r) => r.bars.some((b) => b.state === s)),
    )
  : [];

// ---- areas
const areas = vis.kind === "areas" ? vis : null;
const WORK_STATE: Record<VisAreas["work"][number]["state"], string> = {
  clean: "",
  untracked: "izlənmir",
  modified: "dəyişib",
  deleted: "silinib",
  ignored: "ignore",
};
const INDEX_STATE: Record<VisAreas["index"][number]["state"], string> = {
  clean: "",
  added: "yeni",
  modified: "yenilənib",
  deleted: "silinəcək",
};
const fileClass = (state: string, fresh?: boolean) =>
  `file s-${state}${fresh && state !== "clean" ? " fresh" : ""}`;
---

{slice && (
  <div class="st-vis">
    <div class="st-vis-cap">
      <span>Yaddaş</span>
      <small class="mono">
        len {slice.len} · cap {slice.cap}
      </small>
    </div>
    <div class="vis">
      <div class="vis-row">
        <span class="vis-name">{slice.name}</span>
        <div class="cells">
          {slice.nil ? (
            <span class="cell cap">nil</span>
          ) : (
            cells.map((c) => (
              <span class="vcell">
                <span
                  class:list={["cell", c.inLen ? "on" : "cap", { new: c.isNew }]}
                  style={`--d:${c.k * 70}ms`}
                >
                  {c.text}
                </span>
                <small>{c.k}</small>
              </span>
            ))
          )}
        </div>
      </div>
      {slice.window && (
        <p class="vis-note">
          eyni array, fərqli pəncərə: <code>{slice.name}</code> {slice.window[0]}–
          {slice.window[1] - 1} indekslərini görür
        </p>
      )}
    </div>
  </div>
)}

{map && (
  <div class="st-vis">
    <div class="st-vis-cap">
      <span>Map</span>
      <small class="mono">len {Object.keys(map.entries).length}</small>
    </div>
    <div class="vis vis-map">
      <div class="vis-row">
        <span class="vis-name">{map.name}</span>
        {mapRows.length ? (
          <ul class="kv-list">
            {mapRows.map((r, i) => (
              <li class:list={["kv", { gone: r.gone }]}>
                <span class="kv-k">{quoted(r.k)}</span>
                <span class="kv-arrow" aria-hidden="true">
                  →
                </span>
                {r.gone ? (
                  <span class="kv-gone">silindi</span>
                ) : (
                  <span class:list={["cell", "on", { new: r.fresh }]} style={`--d:${i * 70}ms`}>
                    {r.v}
                  </span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <span class="cell cap">boş map</span>
        )}
      </div>
      {map.lookup && (
        <p class="vis-lookup">
          <code>{`${map.name}[${quoted(map.lookup.key)}]`}</code>
          <span aria-hidden="true">→</span>
          <span>
            dəyər <b class="mono">{map.lookup.value}</b>, ok{" "}
            <b class:list={["mono", map.lookup.ok ? "is-ok" : "is-miss"]}>
              {String(map.lookup.ok)}
            </b>
          </span>
          <small>
            {map.lookup.ok ? "açar var" : "belə açar yoxdur: zero value qayıdır, ok isə false olur"}
          </small>
        </p>
      )}
    </div>
  </div>
)}

{chan && (
  <div class="st-vis">
    <div class="st-vis-cap">
      <span>Channel</span>
      <small class="mono">
        {chan.cap === 0 ? "unbuffered" : `len ${chan.buf.length} · cap ${chan.cap}`}
        {chan.closed ? " · closed" : ""}
      </small>
    </div>
    <div class="vis vis-chan">
      <div class="chan">
        <div class:list={["chan-end", { waited: chan.waited === "sender" }]}>
          <b>{chan.from ?? "—"}</b>
          <small>{chan.waited === "sender" ? "gözlədi" : "göndərən"}</small>
        </div>
        <span class="chan-arrow" aria-hidden="true">
          →
        </span>
        <div class="chan-pipe">
          <span class="chan-name">{chan.name}</span>
          <div class="cells">
            {chan.cap === 0 ? (
              <span class="cell cap chan-hand">əldən-ələ</span>
            ) : (
              slots.map((s, i) => (
                <span
                  class:list={["cell", s.text === undefined ? "cap" : "on", { new: s.isNew }]}
                  style={`--d:${i * 70}ms`}
                >
                  {s.text === undefined ? "·" : quoted(s.text)}
                </span>
              ))
            )}
          </div>
        </div>
        <span class="chan-arrow" aria-hidden="true">
          →
        </span>
        <div class:list={["chan-end", { waited: chan.waited === "receiver" }]}>
          <b>{chan.to ?? "—"}</b>
          <small>{chan.waited === "receiver" ? "gözlədi" : "qəbul edən"}</small>
          {chan.took && chan.took.length > 0 && (
            <span class="cells chan-took">
              {chan.took.map((v, i) => (
                <span class="cell on new" style={`--d:${i * 90}ms`}>
                  {quoted(v)}
                </span>
              ))}
            </span>
          )}
        </div>
      </div>
    </div>
  </div>
)}

{tl && (
  <div class="st-vis">
    <div class="st-vis-cap">
      <span>Zaman xətti</span>
      <small class="mono">0–{tl.total} ms</small>
    </div>
    <div class="vis vis-tl" style={`--ticks:${ticks.length - 1}`}>
      {tl.rows.map((r) => (
        <div class="tl-row">
          <span class="tl-name">{r.name}</span>
          <div class="tl-track">
            {r.bars.map((b) => (
              <span
                class={`tl-bar s-${b.state}`}
                style={`left:${pct(b.from)};width:${pct(b.to - b.from)};--d:${b.from * 3}ms`}
                title={`${r.name}: ${b.label ?? ""} ${b.from}–${b.to} ms, ${TL_STATE[b.state]}`}
              >
                {b.label}
              </span>
            ))}
          </div>
        </div>
      ))}
      <div class="tl-row tl-axis" aria-hidden="true">
        <span class="tl-name" />
        <div class="tl-track">
          {ticks.map((t) => (
            <small style={`left:${pct(t)}`}>{t}</small>
          ))}
        </div>
      </div>
      <p class="tl-legend">
        {tlStates.map((s) => (
          <span class={`s-${s}`}>{TL_LEGEND[s]}</span>
        ))}
      </p>
      {tl.note && <p class="vis-note">{tl.note}</p>}
    </div>
  </div>
)}

{areas && (
  <div class="st-vis">
    <div class="st-vis-cap">
      <span>Üç sahə</span>
      <small class="mono">{areas.repo.count} commit</small>
    </div>
    <div class="vis vis-areas">
      <div class="areas">
        <section class="area" aria-label="Working directory">
          <header class="area-head">
            <b>Working directory</b>
            <small>iş qovluğu</small>
          </header>
          <ul class="files">
            {areas.work.map((f, i) => (
              <li class={fileClass(f.state, f.fresh)} style={`animation-delay:${i * 50}ms`}>
                <span class="fname">{f.name}</span>
                {WORK_STATE[f.state] && <span class="fstate">{WORK_STATE[f.state]}</span>}
              </li>
            ))}
          </ul>
          {areas.work.length === 0 && <p class="area-empty">boş</p>}
        </section>

        <span class="area-arrow" aria-hidden="true">
          ›
        </span>

        <section class="area" aria-label="Staging area">
          <header class="area-head">
            <b>Staging area</b>
            <small>növbəti snapshot</small>
          </header>
          <ul class="files">
            {areas.index.map((f, i) => (
              <li class={fileClass(f.state, f.fresh)} style={`animation-delay:${i * 50}ms`}>
                <span class="fname">{f.name}</span>
                {INDEX_STATE[f.state] && <span class="fstate">{INDEX_STATE[f.state]}</span>}
              </li>
            ))}
          </ul>
          {areas.index.length === 0 && <p class="area-empty">boş</p>}
        </section>

        <span class="area-arrow" aria-hidden="true">
          ›
        </span>

        <section class="area" aria-label="Repository">
          <header class="area-head">
            <b>Repository</b>
            <small>{areas.repo.count} commit</small>
          </header>
          {areas.repo.commit ? (
            <>
              <p class={`commit${areas.repo.fresh ? " fresh" : ""}`}>
                <span class="hash">{areas.repo.commit.hash}</span>
                <span class="msg">{areas.repo.commit.message}</span>
              </p>
              <ul class="files">
                {areas.repo.files.map((name) => (
                  <li class="file s-clean">
                    <span class="fname">{name}</span>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <p class="area-empty">hələ commit yoxdur</p>
          )}
        </section>
      </div>
    </div>
  </div>
)}
