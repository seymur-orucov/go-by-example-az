---
// Inline SVG icons. Section icons are referenced by name from content/<technology>/sections.yaml.
interface Props {
  name: string;
}

const PATHS: Record<string, string> = {
  spark:
    '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
  stack: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/>',
  func: '<path d="M8 20c2 0 3-1 3.5-3.5L13 7.5C13.5 5 14.5 4 16.5 4M7.5 11h9"/>',
  shape:
    '<rect x="3" y="3" width="8" height="8" rx="2"/><circle cx="17" cy="17" r="4"/><path d="M14 3h7v7"/>',
  alert:
    '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0ZM12 9v4M12 17h.01"/>',
  flow: '<path d="M4 6h10M4 12h16M4 18h7"/><path d="m17 3 3 3-3 3M17 15l3 3-3 3"/>',
  text: '<path d="M4 7V5h16v2M9 19h6M12 5v14"/>',
  file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z"/><path d="M14 3v6h6"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  chev: '<path d="m9 6 6 6-6 6"/>',
  circle: '<circle cx="12" cy="12" r="9"/>',
};

const CHECK =
  '<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.7 7.7-5.5 5.5a1 1 0 0 1-1.4 0l-2.5-2.5a1 1 0 1 1 1.4-1.4l1.8 1.8 4.8-4.8a1 1 0 0 1 1.4 1.4Z"/>';

const { name } = Astro.props;
const filled = name === "check";
const body = filled ? CHECK : (PATHS[name] ?? "");
---

{filled ? (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={body} />
) : (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={body}
  />
)}
