---
// v2 site header: logo, main nav with the technology mega menu, search trigger, look menu.
// Lesson pages add the sidebar toggle and the view-mode menu (sidebar, width, Zen).
import type { TechState } from "../data/platform";

interface Props {
  /** Nav item shown as the current page: "roadmaps" or a technology id ("go", "git"). */
  current?: string;
  /** Technologies that have started or finished; each gets a nav link. */
  active?: TechState[];
  /** Solid glass from the start (lesson pages). */
  solid?: boolean;
  lesson?: boolean;
}
const { current, active = [], solid, lesson } = Astro.props;
---

<header class:list={["site-header", { solid }]}>
  {lesson && (
    <button
      class="btn btn-ghost btn-icon sb-toggle"
      data-sb-toggle
      aria-label="Mövzular panelini göstər / gizlət"
      title="Mövzular paneli  ["
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect
          class="sb-fill"
          x="3"
          y="4"
          width="6"
          height="16"
          rx="2"
          fill="currentColor"
          stroke="none"
        />
        <rect x="3" y="4" width="18" height="16" rx="3" />
        <path d="M9 4v16" />
      </svg>
    </button>
  )}
  <a class="logo" href="/" aria-label="Ana səhifə">
    <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
      <defs>
        <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="var(--cyan)"></stop>
          <stop offset=".5" stop-color="var(--accent)"></stop>
          <stop offset="1" stop-color="var(--accent-2)"></stop>
        </linearGradient>
      </defs>
      <rect x="1" y="1" width="30" height="30" rx="9" fill="url(#lg)" opacity=".16"></rect>
      <rect
        x="1"
        y="1"
        width="30"
        height="30"
        rx="9"
        fill="none"
        stroke="url(#lg)"
        stroke-opacity=".7"
      ></rect>
      <path
        d="M8 21.5 12.5 11l3.5 7 3.5-7L24 21.5"
        fill="none"
        stroke="url(#lg)"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
      <circle cx="8" cy="21.5" r="1.8" fill="var(--cyan)"></circle>
      <circle cx="24" cy="21.5" r="1.8" fill="var(--accent-2)"></circle>
    </svg>
    <span data-brand>
      w3hub<span class="logo-tld">.dev</span>
    </span>
  </a>
  <nav class="nav" aria-label="Əsas menyu">
    <a href="/go/roadmap/" aria-current={current === "roadmaps" ? "page" : undefined}>
      Yol xəritələri
    </a>
    <div class="dd">
      <button data-menu-btn aria-expanded="false">
        Texnologiyalar <i data-icon="chev"></i>
      </button>
      <div class="menu mega" data-tech-menu hidden></div>
    </div>
    {!lesson && <a href="/#bolmeler">Bölmələr</a>}
    {active.map((t) => (
      <a href={t.href} aria-current={current === t.id ? "page" : undefined}>
        {t.name}
      </a>
    ))}
  </nav>
  <div class="header-spacer"></div>
  <div class="header-right">
    <button class="search-trigger" data-open-search aria-label="Axtarış (Ctrl+K)">
      <i data-icon="search"></i>
      <span>Axtar…</span>
      <kbd>Ctrl K</kbd>
    </button>
    {lesson && (
      <div class="dd">
        <button
          class="btn btn-ghost btn-icon"
          data-menu-btn
          aria-expanded="false"
          aria-label="Görünüş rejimləri"
          title="Görünüş rejimləri"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="16" rx="3" />
            <path d="M3 9h18M9 9v11" />
          </svg>
        </button>
        <div class="menu right view-menu" hidden>
          <div class="menu-label">Görünüş</div>
          <button class="vm-row" data-act="sidebar" role="menuitemcheckbox" aria-checked="true">
            <span class="t">
              Mövzular paneli<small>soldakı siyahı</small>
            </span>
            <kbd>[</kbd>
            <span class="switch" aria-hidden="true" />
          </button>
          <div class="vm-row vm-static">
            <span class="t">
              Kontent eni<small>mərkəzdə oxumaq daha rahatdır</small>
            </span>
            <kbd>F</kbd>
          </div>
          <div class="seg seg-2" role="radiogroup" aria-label="Kontent eni">
            <button role="radio" data-width-opt="center" aria-pressed="true">
              Mərkəzdə
            </button>
            <button role="radio" data-width-opt="full" aria-pressed="false">
              Tam en
            </button>
          </div>
          <button class="vm-row" data-zen-toggle>
            <span class="t">
              Zen rejimi<small>yalnız dərs qalır</small>
            </span>
            <kbd>Z</kbd>
          </button>
        </div>
      </div>
    )}
    <div class="dd">
      <button
        class="btn btn-ghost btn-icon"
        data-menu-btn
        aria-expanded="false"
        aria-label="Görünüş: tema və palitra"
        title="Tema və palitra"
      >
        <span data-look-icon style="display:contents"></span>
      </button>
      <div class="menu right" data-look-menu hidden style="min-width:230px"></div>
    </div>
    {!lesson && (
      <a class="btn btn-sm btn-signin" href="/#basla">
        Daxil ol
      </a>
    )}
    <button
      class="btn btn-ghost btn-icon menu-toggle"
      data-nav-toggle
      aria-label="Menyu"
      aria-expanded="false"
    >
      <i data-icon="menu"></i>
    </button>
  </div>
</header>
