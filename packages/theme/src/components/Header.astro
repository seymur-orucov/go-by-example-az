---
import ViewMenu from "./ViewMenu.astro";
// Site header: logo, technology switcher, main nav, search trigger, palette picker, theme toggle.
// Routes follow /<technology>/...; directions live under /roadmaps/.
/** A technology in the switcher; the site computes `status` from its content. */
export interface TechMenuItem {
  id: string;
  name: string;
  color: string;
  status: "ready" | "started" | "soon";
  ready: number;
  total: number;
  /** Set for active (ready or started) technologies. */
  href?: string;
}

interface Props {
  /** The switcher's list: active technologies are links, the rest show "tezliklə". */
  technologies?: TechMenuItem[];
  /** Technology section the page belongs to ("go", "git"); changes the switcher label and nav. */
  tech?: string;
  /** Lesson pages: sidebar toggle and the view-mode menu (sidebar, width, Zen). */
  lesson?: boolean;
}
const { technologies = [], tech, lesson } = Astro.props;
const current = technologies.find((t) => t.id === tech);
const statusLabel = (t: TechMenuItem) =>
  t.status === "ready"
    ? "hazırdır"
    : t.status === "started"
      ? `başlanıb · ${t.ready}/${t.total}`
      : "tezliklə";
---

<header class="site-header">
  {lesson && (
    <button
      class="btn btn-ghost btn-icon sb-toggle"
      data-sb-toggle
      aria-label="Mövzular panelini göstər / gizlət"
      title="Mövzular paneli  ["
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect
          class="sb-fill"
          x="3"
          y="4"
          width="6"
          height="16"
          rx="2"
          fill="currentColor"
          stroke="none"
        />
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M9 4v16" />
      </svg>
    </button>
  )}
  <a class="logo" href="/" aria-label="Nümunələrlə — ana səhifə">
    <span class="logo-mark">nü</span>
    <span class="logo-text">Nümunələrlə</span>
  </a>
  <div class="dd">
    <button class="tech-switch" data-menu-btn aria-label="Texnologiya seç">
      {current ? (
        <span class="dot" style={`background:${current.color}`} />
      ) : (
        <span class="dot dot-all" />
      )}
      {current ? current.name : "Texnologiya"}
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </button>
    <div class="menu" hidden>
      <div class="menu-title label">Texnologiyalar</div>
      {technologies.map((t) =>
        t.href ? (
          <a
            class="menu-item"
            href={t.href}
            aria-current={t.id === tech ? "page" : undefined}
            title={`${t.ready} / ${t.total} dərs hazırdır`}
          >
            <span class="dot" style={`background:${t.color}`} />
            {t.name}
            <small>{statusLabel(t)}</small>
          </a>
        ) : (
          <span class="menu-item soon">
            <span class="dot" style={`background:${t.color}`} />
            {t.name}
            <small>{statusLabel(t)}</small>
          </span>
        ),
      )}
      <div class="menu-title label">İstiqamətlər</div>
      <a class="menu-item" href="/roadmaps/backend/">
        <span class="dot" style="background:#8b5cf6"></span>Backend<small>önizləmə</small>
      </a>
      <span class="menu-item soon">
        <span class="dot" style="background:#f472b6"></span>Frontend<small>tezliklə</small>
      </span>
    </div>
  </div>
  <nav class="nav" aria-label="Əsas menyu">
    {tech === "go" ? (
      <>
        <a href="/go/#proqram" aria-current={Astro.url.pathname === "/go/" ? "page" : undefined}>
          Nümunələr
        </a>
        <a href="/go/roadmap/">Yol xəritəsi</a>
        <a href="https://go.dev/play/" target="_blank" rel="noopener">
          Playground
        </a>
      </>
    ) : current ? (
      <>
        <a
          href={`/${current.id}/#proqram`}
          aria-current={Astro.url.pathname === `/${current.id}/` ? "page" : undefined}
        >
          Mövzular
        </a>
        <a href="/#bolmeler">Bölmələr</a>
      </>
    ) : (
      <>
        <a href="/go/roadmap/">Yol xəritəsi</a>
        <a href="/#bolmeler">Bölmələr</a>
        {technologies
          .filter((t) => t.href)
          .map((t) => (
            <a href={t.href}>{t.name}</a>
          ))}
      </>
    )}
  </nav>
  <div class="header-spacer"></div>
  <div class="header-right">
    <button class="search-trigger" data-open-search aria-label="Axtarış (Ctrl+K)">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <span>{tech === "go" ? "Nümunə axtar…" : "Mövzu axtar…"}</span>
      <kbd>Ctrl K</kbd>
    </button>
    {lesson && <ViewMenu />}
    <div class="dd palette-picker">
      <button
        class="btn btn-ghost btn-icon"
        data-menu-btn
        aria-label="Rəng palitrası"
        title="Rəng palitrası"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="13.5" cy="6.5" r="1.5"></circle>
          <circle cx="17.5" cy="10.5" r="1.5"></circle>
          <circle cx="8.5" cy="7.5" r="1.5"></circle>
          <circle cx="6.5" cy="12.5" r="1.5"></circle>
          <path d="M12 2a10 10 0 0 0 0 20c1 0 1.7-.8 1.7-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.8-1.7 1.7-1.7H17a5 5 0 0 0 5-5c0-4.9-4.5-8.4-10-8.4Z"></path>
        </svg>
      </button>
      <div class="menu" data-palette-menu hidden></div>
    </div>
    <button class="btn btn-ghost btn-icon" data-theme-toggle></button>
  </div>
</header>
