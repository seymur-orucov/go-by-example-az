---
import "../styles/index.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface SearchEntry {
  slug: string;
  title: string;
  sub: string;
  section: string;
  n: number;
  href: string;
  ready: boolean;
}

interface Props {
  title: string;
  description?: string;
  /** Entries for the Ctrl+K palette and the page scripts; the site builds them from its content. */
  searchIndex?: SearchEntry[];
  /** Nav item shown as the current page. */
  current?: "roadmaps" | "go";
  /** Lesson pages: sidebar toggle, view modes (sidebar, width, Zen), solid header, slim footer. */
  lesson?: boolean;
  /** Class on <body> (page-specific styles hang on it). */
  bodyClass?: string;
  /** Show the Go by Example CC BY 3.0 attribution (only while adapted lessons exist). */
  attribution?: boolean;
}

const {
  title,
  description,
  searchIndex = [],
  current,
  lesson,
  bodyClass,
  attribution = true,
} = Astro.props;
---

<!doctype html>
<html lang="az">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Apply the saved theme, palette and view modes before first paint (no flash). -->
    <script is:inline>
      try {
        const s = localStorage;
        const d = document.documentElement;
        const t = JSON.parse(s.getItem("w3:theme"));
        const p = JSON.parse(s.getItem("w3:palette"));
        if (t && t !== "system") d.setAttribute("data-theme", t);
        if (p && p !== "nebula") d.setAttribute("data-palette", p);
        if (s.getItem("w3:sidebar") === "off") d.setAttribute("data-sidebar", "off");
        if (s.getItem("w3:width") === "full") d.setAttribute("data-width", "full");
        if (sessionStorage.getItem("w3:zen") === "1") d.setAttribute("data-zen", "");
      } catch {
        /* storage unavailable: system theme, default view */
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <slot name="before-header" />
    <Header current={current} solid={lesson} lesson={lesson} />
    <slot />
    <Footer attribution={attribution} slim={lesson} />
    <script
      type="application/json"
      id="search-index"
      set:html={JSON.stringify(searchIndex).replace(/</g, "\\u003c")}
    />
    <script>
      import "../scripts/v2";
    </script>
  </body>
</html>
