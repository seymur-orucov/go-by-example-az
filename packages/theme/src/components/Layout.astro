---
import "../styles/index.css";
import Footer from "./Footer.astro";
import Header, { type TechMenuItem } from "./Header.astro";

interface SearchEntry {
  slug: string;
  title: string;
  sub: string;
  section: string;
  n: number;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  /** Entries for the Ctrl+K palette; the site builds them from its content collections. */
  searchIndex?: SearchEntry[];
  /** The technology switcher; the site computes each status from its content. */
  technologies?: TechMenuItem[];
  /** Technology section the page belongs to ("go", "git"). */
  tech?: string;
  /** Lesson pages: view modes (sidebar, width, Zen) in the header. */
  lesson?: boolean;
  /** Show the Go by Example CC BY 3.0 attribution (only while adapted lessons exist). */
  attribution?: boolean;
}

const {
  title,
  description,
  searchIndex = [],
  technologies,
  tech,
  lesson,
  attribution = true,
} = Astro.props;
---

<!doctype html>
<html lang="az">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Apply the saved theme and palette before first paint (no flash). -->
    <script is:inline>
      try {
        const d = document.documentElement;
        const t = JSON.parse(localStorage.getItem("goaz:theme"));
        if (t === "light" || t === "dark") d.setAttribute("data-theme", t);
        const p = JSON.parse(localStorage.getItem("goaz:palette"));
        if (p && p !== "nebula") d.setAttribute("data-palette", p);
      } catch {
        /* storage unavailable: fall back to the system theme */
      }
    </script>
    {lesson && <script is:inline>
      try {
        const d = document.documentElement;
        if (localStorage.getItem("goaz:sidebar") === "off") d.setAttribute("data-sidebar", "off");
        if (localStorage.getItem("goaz:width") === "full") d.setAttribute("data-width", "full");
        if (sessionStorage.getItem("goaz:zen") === "1") d.setAttribute("data-zen", "");
      } catch {
        /* storage unavailable: default view */
      }
    </script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header technologies={technologies} tech={tech} lesson={lesson} />
    <slot />
    <Footer attribution={attribution} />
    <script
      type="application/json"
      id="search-index"
      set:html={JSON.stringify(searchIndex).replace(/</g, "\\u003c")}
    />
    <script>
      import "../scripts/shell";
    </script>
  </body>
</html>
