---
// "Görünüş" menu on lesson pages: sidebar, content width, Zen. Behavior: scripts/view-modes.ts.
---

<div class="dd view-picker">
  <button class="btn btn-ghost btn-icon" data-menu-btn aria-label="Görünüş" title="Görünüş">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="4" width="18" height="16" rx="2"></rect>
      <path d="M3 9h18M9 9v11"></path>
    </svg>
  </button>
  <div class="menu view-menu" hidden>
    <div class="menu-title label">Görünüş</div>
    <button class="vm-row" data-act="sidebar" role="menuitemcheckbox" aria-checked="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="4" width="18" height="16" rx="2"></rect>
        <path d="M9 4v16"></path>
      </svg>
      <span class="t">
        Mövzular paneli<small>soldakı sidebar</small>
      </span>
      <kbd>[</kbd>
      <span class="switch"></span>
    </button>
    <div class="vm-row vm-static">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 12h18M7 8l-4 4 4 4M17 8l4 4-4 4"></path>
      </svg>
      <span class="t">
        Kontent eni<small>oxumaq üçün mərkəzdə daha rahatdır</small>
      </span>
      <kbd>F</kbd>
    </div>
    <div class="vm-seg" role="radiogroup" aria-label="Kontent eni">
      <button role="radio" data-width-opt="center" aria-checked="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 5v14M20 5v14"></path>
          <rect x="8" y="7" width="8" height="10" rx="1.5"></rect>
        </svg>
        Mərkəzdə
      </button>
      <button role="radio" data-width-opt="full" aria-checked="false">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="7" width="18" height="10" rx="1.5"></rect>
        </svg>
        Tam en
      </button>
    </div>
    <div class="menu-sep"></div>
    <button class="vm-row" data-zen-toggle>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"></path>
      </svg>
      <span class="t">
        Zen rejimi<small>yalnız dərs — header, panel, footer gizlənir</small>
      </span>
      <kbd>Z</kbd>
    </button>
  </div>
</div>
